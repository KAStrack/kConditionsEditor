{
  "name": "kastrack/conditions-editor",
  "description": "PHP evaluator for kConditionsEditor documents — pass in field values and a condition document, get a boolean back.",
  "type": "library",
  "license": "MIT",
  "keywords": ["conditions", "rules", "rule-engine", "query-builder", "json-logic"],
  "homepage": "https://github.com/KAStrack/kConditionsEditor",
  "authors": [
    {
      "name": "Ben",
      "homepage": "https://github.com/KAStrack"
    }
  ],
  "require": {
    "php": ">=8.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5 || ^11.0",
    "phpstan/phpstan": "^1.11"
  },
  "autoload": {
    "psr-4": {
      "Kastrack\\ConditionsEditor\\": "sdk/php/src/"
    },
    "files": [
      "sdk/php/src/functions.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Kastrack\\ConditionsEditor\\Tests\\": "sdk/php/tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "analyse": "phpstan analyse"
  },
  "config": {
    "sort-packages": true
  },
  "minimum-stability": "stable"
}
